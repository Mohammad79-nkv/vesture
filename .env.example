# ──────────────────────────────────────────────────────────────────────
# Vesture — environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ──────────────────────────────────────────────────────────────────────

# ─── Database (Neon) ────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host.neon.tech/vesture?sslmode=require&channel_binding=require"
# Direct (unpooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host.neon.tech/vesture?sslmode=require&channel_binding=require"

# ─── Clerk (auth) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Webhook signing secret from the Clerk dashboard (Webhooks → Endpoint).
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Cloudinary (image hosting) ─────────────────────────────────────────
# Sign up at https://cloudinary.com/users/register_free, then grab these
# from Dashboard → Account Details. Closet + product image uploads will
# 401 against Cloudinary until these are real (the placeholder cloud_name
# below is just a marker, not a real account).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Folder products are uploaded under (keeps the asset library tidy).
CLOUDINARY_UPLOAD_FOLDER="vesture/products"

# ─── OpenRouter (AI stylist — Phase 2) ──────────────────────────────────
# We route Claude calls through OpenRouter for cross-model flexibility.
# Get from https://openrouter.ai/settings/keys and set a credit limit on
# the same screen before shipping the chat endpoint to production.
OPENROUTER_API_KEY="sk-or-..."
# Model slug — see https://openrouter.ai/models. Anthropic's Sonnet is a
# good starting point on cost; swap to opus or another provider's model
# without touching code.
OPENROUTER_STYLIST_MODEL="anthropic/claude-sonnet-4.5"
# Vision model for closet auto-tagging (frame 08). Cheap multimodal
# default — swap to claude-haiku-4.5 or any other vision-capable
# OpenRouter slug if you want vendor consistency. Token usage folds
# into the same per-user daily budget below.
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
# Optional but recommended — these show up in OpenRouter's analytics so
# you can attribute traffic. NEXT_PUBLIC_APP_URL doubles as the site URL.
OPENROUTER_SITE_NAME="Vesture"
# Hard ceiling per user per UTC day. Stylist refuses turns once exceeded
# until the bucket resets at midnight UTC. Tune after a week of telemetry.
STYLIST_DAILY_TOKEN_BUDGET_PER_USER="50000"

# ─── Upstash Redis (rate limiting — Phase 2) ────────────────────────────
# Sliding-window rate limit on /api/stylist (keyed by userId or IP).
# Free tier at https://upstash.com is enough for MVP — create a Redis DB
# in the same region as the Vercel deployment for low-latency reads.
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Voyage (embeddings — Phase 3) ──────────────────────────────────────
VOYAGE_API_KEY="pa-..."

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

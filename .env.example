# ──────────────────────────────────────────────────────────────────────
# Vesture — environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ──────────────────────────────────────────────────────────────────────

# ─── Database (Neon) ────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host.neon.tech/vesture?sslmode=require&channel_binding=require"
# Direct (unpooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host.neon.tech/vesture?sslmode=require&channel_binding=require"

# ─── Clerk (auth) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Webhook signing secret from the Clerk dashboard (Webhooks → Endpoint).
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Cloudinary (image hosting) ─────────────────────────────────────────
# Sign up at https://cloudinary.com/users/register_free, then grab these
# from Dashboard → Account Details. Closet + product image uploads will
# 401 against Cloudinary until these are real (the placeholder cloud_name
# below is just a marker, not a real account).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Folder products are uploaded under (keeps the asset library tidy).
CLOUDINARY_UPLOAD_FOLDER="vesture/products"

# ─── Anthropic (AI stylist — Phase 2) ───────────────────────────────────
# Get from https://console.anthropic.com/settings/keys
# Set a monthly spend limit on the same screen before shipping the chat
# endpoint to production.
ANTHROPIC_API_KEY="sk-ant-..."
# Hard ceiling per user per UTC day. Stylist refuses turns once exceeded
# until the bucket resets at midnight UTC. Tune after a week of telemetry.
ANTHROPIC_DAILY_TOKEN_BUDGET_PER_USER="50000"
# Default model for the stylist orchestrator. claude-sonnet-4-6 is a good
# starting point on cost; switch to opus-4-7 for harder style reasoning.
ANTHROPIC_STYLIST_MODEL="claude-sonnet-4-6"

# ─── Upstash Redis (rate limiting — Phase 2) ────────────────────────────
# Sliding-window rate limit on /api/stylist (keyed by userId or IP).
# Free tier at https://upstash.com is enough for MVP — create a Redis DB
# in the same region as the Vercel deployment for low-latency reads.
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Voyage (embeddings — Phase 3) ──────────────────────────────────────
VOYAGE_API_KEY="pa-..."

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

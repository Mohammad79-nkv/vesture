// ──────────────────────────────────────────────────────────────────────
// Vesture — Prisma schema
// pgvector is enabled here from day 1 so Phase 3 needs no DB-extension migration.
// The `vector` column is unused until Phase 3.
// ──────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ─── Users ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Onboarding — `styleTags` stores the picks from the Quick-taste step
  // (Streetwear / Minimal / Romantic …). The Phase-2 stylist consumes them
  // as soft preferences; until then they're inert. `onboardedAt` is set the
  // moment a user submits the taste step — auth-gated routes redirect to
  // /onboarding/taste while it's null.
  styleTags   String[]  @default([])
  onboardedAt DateTime?

  sellerProfile SellerProfile?
  favorites     Favorite[]
  chatSessions  ChatSession[]
  adminActions  AdminAction[]  @relation("AdminActor")
  closetPieces  ClosetPiece[]
  savedOutfits  SavedOutfit[]
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// ─── Sellers ────────────────────────────────────────────────────────────

model SellerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeNameEn     String
  storeNameAr     String?
  slug            String       @unique
  bioEn           String?
  bioAr           String?
  logoUrl         String?
  coverUrl        String?
  instagramUrl    String?
  whatsappE164    String?
  countryCode     String // ISO 3166-1 alpha-2 (AE, SA, EG, ...)
  defaultCurrency String // ISO 4217 (AED, SAR, EGP, ...)
  status          SellerStatus @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products Product[]

  @@index([status])
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─── Products ───────────────────────────────────────────────────────────

model Product {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  titleEn       String
  titleAr       String?
  slug          String  @unique
  descriptionEn String
  descriptionAr String?
  priceMinor    Int // smallest currency unit
  currency      String // ISO 4217

  category Category
  gender   Gender
  season   Season?
  occasion Occasion?
  style    Style?

  sizes  String[]
  colors String[] // normalized lowercase

  // Phase 3 fields — populated by AI tagging + embedding pipeline
  aiTags       String[]                     @default([])
  aiConfidence Float?
  embedding    Unsupported("vector(1024)")?
  embeddedAt   DateTime?

  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images       ProductImage[]
  favorites    Favorite[]
  chatMentions ChatMessageProduct[]

  @@index([sellerId, status])
  @@index([category, gender, status])
  @@index([priceMinor])
  @@index([status, publishedAt])
}

enum Category {
  TOPS
  BOTTOMS
  DRESSES
  OUTERWEAR
  SHOES
  BAGS
  ACCESSORIES
}

enum Gender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
  ALL_SEASON
}

enum Occasion {
  CASUAL
  WORK
  FORMAL
  EVENING
  WEDDING
  VACATION
  SPORT
}

enum Style {
  MINIMAL
  STREETWEAR
  CLASSIC
  BOHO
  LUXURY
  VINTAGE
  EDGY
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  alt       String?
  position  Int     @default(0)

  @@index([productId, position])
}

// ─── Favorites ──────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Chat (Phase 2) ─────────────────────────────────────────────────────

model ChatSession {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousCookie String?  @unique // signed cookie value for pre-auth attach
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  toolCalls  Json?
  // Sum of prompt + completion tokens that produced this turn. Only set on
  // ASSISTANT rows (USER rows leave it 0); used for the daily budget check
  // in /api/stylist.
  tokensUsed Int         @default(0)
  createdAt  DateTime    @default(now())

  products ChatMessageProduct[]

  @@index([sessionId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// Many-to-many between ChatMessage and Product (products surfaced in a turn)
model ChatMessageProduct {
  messageId String
  productId String
  position  Int
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([messageId, productId])
  @@index([productId])
}

// ─── Closet (personal wardrobe) ─────────────────────────────────────────
// One ClosetPiece = one photographed garment owned by a buyer. Tags are
// manual today; Phase 3 will populate them from Claude vision and surface
// ai-suggestions in piece detail.

model ClosetPiece {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl String
  publicId String // Cloudinary public_id

  name      String? // user-given (e.g. "Camel wool overcoat")
  category  Category
  color     String? // free-form ("Camel", "Burgundy") + swatch hex
  swatchHex String? // for grid tile background fidelity
  fabric    String? // free-form ("Cotton", "Cashmere", ...)
  formality Formality?
  season    Season?
  brand     String?
  notes     String?

  // Phase 3 fields — populated by AI vision tagger
  aiTags       String[] @default([])
  aiConfidence Float?

  // Wear log denormalized for fast list rendering. A separate WearLog table
  // can be added in Phase 2.5 when calendar / pair history land.
  wearCount  Int       @default(0)
  lastWornAt DateTime?

  status    PieceStatus @default(IN_CLOSET)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  outfitSlots SavedOutfitPiece[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, lastWornAt])
}

enum Formality {
  CASUAL
  SMART_CASUAL
  FORMAL
}

enum PieceStatus {
  IN_CLOSET
  LENT
  CLEANER
  STORAGE
  DONATED
  ARCHIVED
}

// ─── Saved outfits (Phase 3 outfit builder) ─────────────────────────────
// SavedOutfit = one composed look. SavedOutfitPiece = which closet piece
// fills which mannequin slot (TOP / BOTTOM / DRESS / OUTER / SHOES / BAG /
// ACCESSORY). DRESS conflicts with TOP+BOTTOM by service-layer rule, not
// a schema constraint, so the slot column stays a flat string instead of
// a constrained enum-pair.
//
// AI fields on SavedOutfit are nullable from day one (Phase 3A) and stay
// null until the Phase 3B scoring endpoint writes them. Inlining now
// avoids a second migration when 3B lands.

model SavedOutfit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String?
  occasion        Occasion?
  totalPriceMinor Int       @default(0) // sum of pieces' notional retail; 0 since closet pieces are owned
  currency        String? // ISO 4217 — null if outfit has no products mixed in

  wearCount  Int       @default(0)
  lastWornAt DateTime?

  // Phase 3B — AI scoring fields. Stay null until /api/closet/outfit/score runs.
  compositeScore Int?
  subScores      Json? // { harmony: 0-100, fit: 0-100, occasion: 0-100 }
  verdict        Json? // { headline, body }
  whatWorking    Json? // [{ tone, body }, ...]
  whatToTry      Json? // [{ kind: "swap" | "shop", ... }, ...]
  scoredAt       DateTime?
  scoreVersion   Int       @default(1) // bump when prompt or rubric changes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces SavedOutfitPiece[]

  @@index([userId, createdAt])
  @@index([userId, lastWornAt])
  @@index([userId, compositeScore])
}

model SavedOutfitPiece {
  outfitId String
  pieceId  String
  // Slot string — TOP / BOTTOM / DRESS / OUTER / SHOES / BAG / ACCESSORY.
  // Service layer enforces DRESS ↔ TOP+BOTTOM mutual exclusion.
  slot     String

  outfit SavedOutfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  piece  ClosetPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([outfitId, slot])
  @@index([pieceId])
}

// ─── Admin audit log ────────────────────────────────────────────────────

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetType String // "Seller" | "Product"
  targetId   String
  action     String // "APPROVE" | "REJECT" | "SUSPEND" | "ARCHIVE"
  reason     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}
